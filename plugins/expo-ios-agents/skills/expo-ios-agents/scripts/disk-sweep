#!/bin/bash
# disk-sweep: weekly clean-up of what iOS work leaves on a Mac. Dry run unless
# --apply. Never touches a booted simulator, and refuses --apply while ios-q's
# build or boot lane is held.
#
#   disk-sweep                     list what would go, with sizes
#   disk-sweep --apply             remove it
#   --floor 80                     free GB to aim for (default 80); exits 1 when under it
#   --keep-runtime 27.1            keep this simulator runtime too (repeatable)
#   --skip runtimes,devicesupport,deriveddata,unavailable,pnpm,devclient
#
# What it removes:
#   unavailable simulators        xcrun simctl delete unavailable
#   old simulator runtimes        all but the newest per platform, the ones you
#                                 keep, those a paired device runs, any with a
#                                 booted simulator
#   iOS DeviceSupport             folders for iOS versions no paired device runs
#                                 (kept whole when no device is paired)
#   orphaned DerivedData          folders whose WorkspacePath no longer exists,
#                                 untouched for an hour
#   pnpm store                    pnpm store prune
#   dev-client cache              devclient prune --keep 3, when it is installed

set -u
ME=${0##*/}
HERE=$(cd "$(dirname "$0")" && pwd)
APPLY=0; FLOOR=80; KEEP_RT=" "; SKIP=" "
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1; shift ;;
    --floor) FLOOR=${2:-80}; shift 2 ;;
    --keep-runtime) KEEP_RT="$KEEP_RT${2:-} "; shift 2 ;;
    --skip) SKIP=" $(printf '%s' "${2:-}" | tr ',' ' ') "; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "$ME: unknown option $1" >&2; exit 2 ;;
  esac
done
skip() { case "$SKIP" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
simctl() { if [ -n "${IOS_Q_SIMCTL:-}" ]; then "$IOS_Q_SIMCTL" "$@"; else xcrun simctl "$@"; fi; }
DEV=$HOME/Library/Developer
TOTAL_KB=0
free_gb() { df -g "$HOME" | awk 'NR == 2 { print $4 }'; }
kb() { du -sk "$1" 2>/dev/null | cut -f1; }
human() { awk -v k="$1" 'BEGIN { if (k > 1048576) printf "%.1f GB", k / 1048576; else printf "%d MB", k / 1024 }'; }
item() {   # size_kb description
  TOTAL_KB=$((TOTAL_KB + ${1:-0}))
  printf '  %-9s %s\n' "$(human "${1:-0}")" "$2"
}
verb() { if [ "$APPLY" = 1 ]; then echo removed; else echo "would remove"; fi; }

if [ "$APPLY" = 1 ]; then
  Q=${IOS_Q:-$HERE/ios-q}
  if [ -x "$Q" ]; then
    for lane in build boot; do
      h=$("$Q" who "$lane" 2>/dev/null)
      if [ -n "$h" ] && [ "$h" != free ]; then
        echo "$ME: the $lane lane is held ($h); run again when it is free" >&2; exit 3
      fi
    done
  fi
fi

before=$(free_gb)
echo "$ME: $( [ "$APPLY" = 1 ] && echo applying || echo 'dry run (pass --apply to remove)'); free ${before} GB, floor ${FLOOR} GB"

# iOS versions of paired devices, e.g. " 26.6.1 27.1 "
DEVICE_OS=" "
dj=$(mktemp -t disk-sweep)
if xcrun devicectl list devices --json-output "$dj" >/dev/null 2>&1; then
  i=0
  while v=$(plutil -extract "result.devices.$i.deviceProperties.osVersionNumber" raw "$dj" 2>/dev/null); do
    DEVICE_OS="$DEVICE_OS$v "; i=$((i + 1))
  done
fi
rm -f "$dj"
echo "  paired devices run iOS:${DEVICE_OS:- none}"
device_runs() {   # version → 0 when a paired device runs it (matching major.minor)
  local v=$1 d
  for d in $DEVICE_OS; do
    [ "$d" = "$v" ] && return 0
    [ "${d%.*}" = "$v" ] && return 0
    [ "$d" = "${v%.*}" ] && return 0
  done
  return 1
}

echo
echo "unavailable simulators"
if ! skip unavailable; then
  n=$(simctl list devices unavailable 2>/dev/null | grep -cE '\([0-9A-F-]{36}\)' || true)
  if [ "$n" -gt 0 ]; then
    item 0 "$(verb) $n unavailable simulator(s)"
    [ "$APPLY" = 1 ] && simctl delete unavailable
  else echo "  none"; fi
fi

echo
echo "simulator runtimes"
if ! skip runtimes; then
  rt=$(simctl runtime list 2>/dev/null | sed -nE 's/^([A-Za-z]+) ([0-9.]+) \(([^)]*)\) - ([0-9A-F-]{36}) \(([^)]*)\).*/\1|\2|\4/p')
  booted_rt=$(simctl list devices booted 2>/dev/null | awk '/^-- / { h = $0; next } /\(Booted\)/ { print h }' | sort -u)
  json=$(mktemp -t disk-sweep); simctl runtime list -j > "$json" 2>/dev/null
  for plat in $(printf '%s\n' "$rt" | cut -d'|' -f1 | sort -u); do
    newest=$(printf '%s\n' "$rt" | awk -F'|' -v p="$plat" '$1 == p { print $2 }' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
    printf '%s\n' "$rt" | awk -F'|' -v p="$plat" '$1 == p' | while IFS='|' read -r p v id; do
      why=
      [ "$v" = "$newest" ] && why="newest"
      case "$KEEP_RT" in *" $v "*) why="kept by --keep-runtime" ;; esac
      device_runs "$v" && why="a paired device runs it"
      printf '%s\n' "$booted_rt" | grep -qx -- "-- $p $v --" && why="has a booted simulator"
      size=$(( $(plutil -extract "$id.sizeBytes" raw "$json" 2>/dev/null || echo 0) / 1024 ))
      if [ -n "$why" ]; then printf '  %-9s keep %s %s (%s)\n' "$(human "$size")" "$p" "$v" "$why"; continue; fi
      item "$size" "$(verb) $p $v runtime ($id)"
      [ "$APPLY" = 1 ] && simctl runtime delete "$id"
    done
  done
  rm -f "$json"
fi

echo
echo "iOS DeviceSupport"
if ! skip devicesupport; then
  ds="$DEV/Xcode/iOS DeviceSupport"
  if [ ! -d "$ds" ]; then echo "  none"
  elif [ "$DEVICE_OS" = " " ]; then echo "  kept: no paired device to compare against ($(human "$(kb "$ds")"))"
  else
    for d in "$ds"/*/; do
      [ -d "$d" ] || continue
      n=$(basename "$d"); v=$(printf '%s' "$n" | sed -nE 's/^([^ ]+ )?([0-9][0-9.]*) \(.*/\2/p')
      if [ -n "$v" ] && device_runs "$v"; then printf '  %-9s keep %s\n' "$(human "$(kb "$d")")" "$n"; continue; fi
      item "$(kb "$d")" "$(verb) $n"
      [ "$APPLY" = 1 ] && rm -rf "$d"
    done
  fi
fi

echo
echo "DerivedData of projects that no longer exist"
if ! skip deriveddata; then
  dd="$DEV/Xcode/DerivedData"; found=0
  for d in "$dd"/*-*/; do
    [ -f "$d/info.plist" ] || continue
    ws=$(plutil -extract WorkspacePath raw "$d/info.plist" 2>/dev/null) || continue
    [ -e "$ws" ] && continue
    [ -n "$(find "$d" -maxdepth 0 -mmin -60 2>/dev/null)" ] && continue
    found=1
    item "$(kb "$d")" "$(verb) $(basename "$d") (was $ws)"
    [ "$APPLY" = 1 ] && rm -rf "$d"
  done
  [ "$found" = 1 ] || echo "  none"
fi

echo
echo "pnpm store"
if ! skip pnpm && command -v pnpm >/dev/null 2>&1; then
  sp=$(pnpm store path 2>/dev/null)
  if [ -n "$sp" ] && [ -d "$sp" ]; then
    printf '  %-9s %s (prune removes packages no project references)\n' "$(human "$(kb "$sp")")" "$sp"
    if [ "$APPLY" = 1 ]; then pnpm store prune; else echo "  would run: pnpm store prune"; fi
  fi
fi

echo
echo "dev-client cache"
if ! skip devclient && [ -x "$HERE/devclient" ] && [ -d "${IOS_Q_BUILD_CACHE:-$HOME/Library/Caches/ios-q/builds}" ]; then
  c=${IOS_Q_BUILD_CACHE:-$HOME/Library/Caches/ios-q/builds}
  printf '  %-9s %s\n' "$(human "$(kb "$c")")" "$c"
  if [ "$APPLY" = 1 ]; then "$HERE/devclient" prune --keep 3; else echo "  would run: devclient prune --keep 3"; fi
fi

echo
after=$(free_gb)
if [ "$APPLY" = 1 ]; then echo "free ${before} GB → ${after} GB"
else echo "about $(human "$TOTAL_KB") would go (plus whatever pnpm prunes)"; fi
if [ "$after" -lt "$FLOOR" ]; then
  echo "under the floor of ${FLOOR} GB. Other usual suspects: docker system df (then prune), ~/Library/Android and"
  echo "~/.gradle when no Android work is going on, npm cache clean --force, old agent scratch folders, Metro caches in \$TMPDIR."
  exit 1
fi
